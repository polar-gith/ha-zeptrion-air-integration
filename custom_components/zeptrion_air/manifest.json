{
  "domain": "zeptrion_air",
  "name": "Zeptrion Air",
  "codeowners": [
    "@polar-gith"
  ],
  "config_flow": true,
  "dependencies": [
    "http",
    "lovelace"
  ],
  "dhcp": [
    {
      "hostname": "zapp-*"
    }
  ],
  "documentation": "https://github.com/polar-gith/ha-zeptrion-air-integration",
  "iot_class": "local_push",
  "issue_tracker": "https://github.com/polar-gith/ha-zeptrion-air-integration/issues",
  "requirements": [
    "xmltodict>=0.13.0"
  ],
  "version": "2026.11.15",
  "zeroconf": [
    "_zapp._tcp.local.",
    {
      "type": "_http._tcp.local.",
      "name": "zapp-*"
    }
  ]
}
